{
  "name": "daylens-v2-capture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 'tests/**/*.test.ts'",
    "test:large": "node --test --test-concurrency=1 'tests/large/*.large.ts'",
    "typecheck": "tsc --noEmit -p .",
    "capture": "node capture/service.ts",
    "build:js": "tsc -p tsconfig.build.json",
    "build:sqlite": "node tools/buildSqlite.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "electron": "44.5.1",
    "typescript": "7.0.2"
  }
}
