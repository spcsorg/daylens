<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Daylens.Capture.Windows/Native.cs" Link="Windows/Native.cs" />
    <Compile Include="../Daylens.Capture.Windows/Platform.cs" Link="Windows/Platform.cs" />
    <Compile Include="../Daylens.Capture.Windows/AssociationChanges.cs" Link="Windows/AssociationChanges.cs" />
    <Compile Include="../Daylens.Capture.Windows/Resolver.cs" Link="Windows/Resolver.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Daylens.Capture.Core/Daylens.Capture.Core.csproj" />
  </ItemGroup>
</Project>
