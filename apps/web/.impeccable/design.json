  "narrative": {
    "northStar": "The Order Rail",
    "overview": "Your day hangs in order like tickets on a kitchen order rail: each hour is a guest-check slip, numbered in red, written in plain blue-black ink and clipped to one steel bar. The page is the counter the rail hangs over: cool, clean, lit for working, never cream.",
    "keyCharacteristics": [
      "One steel rail, flat, with a single highlight edge.",
      "Guest-check paper for every meaningful container, ruled where text is written.",
      "Check numbers and header rules in red; all text in ink.",
      "One variable face, Archivo, whose width axis carries the hierarchy."
    ],
    "rules": [
      {
        "name": "The Red Ink Rule",
        "body": "Red marks numbers, header rules and \"now\"; it never fills a surface or a button.",
        "section": "colors"
      },
      {
        "name": "The Cool Counter Rule",
        "body": "The ground stays cool off-white. Never cream, never beige.",
        "section": "colors"
      },
      {
        "name": "The Width Axis Rule",
        "body": "Hierarchy comes from width and weight in one family. No second display face.",
        "section": "typography"
      },
      {
        "name": "The Measure Rule",
        "body": "Prose stops at 34em, because Archivo is narrow and rem-based widths hold too many characters.",
        "section": "typography"
      },
      {
        "name": "The One Sheet Rule",
        "body": "Paper never sits inside paper. Content inside a check is written on it, not carded.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put anything that holds Daylens content on guest-check paper, numbered in red, when it is a primary block.",
      "Do rule the paper only where text is written on it, with the rule period equal to the line height.",
      "Do keep tilt at ±0.3° or less, so ticket text stays crisp.",
      "Do label example content as an example."
    ],
    "donts": [
      "Don't draw steel or paper with gradients that imitate material; flat values with a 1px edge only.",
      "Don't nest a white card or a second sheet inside a check.",
      "Don't put a kicker or eyebrow above a heading; a check number belongs to the check's own header row.",
      "Don't use a dark slab for a call to action; the close is a blank check.",
      "Don't add a second typeface or a cream ground."
    ]
  }
